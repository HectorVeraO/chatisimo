# Copy to .env and replace every change-me value. Never commit .env.
DATABASE_URL=postgres://chatisimo:change-me@localhost:10000/chatisimo?sslmode=disable
MASTER_KEY=change-me
CHATISIMO_ENV=local

# Used by .deploy/local/docker-compose.yaml (docker compose --env-file .env)
POSTGRES_USER=chatisimo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatisimo
